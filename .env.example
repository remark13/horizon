# Optional contact metadata for OpenAlex.
SAIA_MAILTO=
OPENALEX_MAILTO=
OPENALEX_API_KEY=

# Optional EPO OPS OAuth credentials. Register a free non-paying application
# at https://developers.epo.org/ and never commit real values.
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=

# Optional. Anonymous Semantic Scholar search can be heavily rate-limited.
SEMANTIC_SCHOLAR_API_KEY=

# Optional broad aggregators. Empty values keep honest access-required states.
# Event Registry / NewsAPI.ai, NOT newsapi.org; existing account quota only.
EVENT_REGISTRY_API_KEY=
# Media Cloud requires explicit collections (comma-separated numeric IDs).
MEDIACLOUD_API_KEY=
MEDIACLOUD_COLLECTION_IDS=
# Lens Patent API entitlement must be enabled for this token.
LENS_API_TOKEN=

# For portability, set this to the target machine's local arXiv snapshot folder.
# SAIA_ARXIV_DATASET_ROOT=/absolute/path/to/local/arxiv
