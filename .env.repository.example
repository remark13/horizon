# Copy to .env in the repository root, then: docker compose up -d --build
# The default URL is http://127.0.0.1:8085/scout . No public hosting is enabled.
HORIZON_PROJECT_NAME=horizon
HORIZON_PORT=8085
POSTGRES_USER=horizon
POSTGRES_PASSWORD=
POSTGRES_DB=horizon

# First scientific analysis downloads pinned SPECTER2 weights into a named
# volume. Downloads need internet access and disk space; startup itself does
# not download weights. No corpus, previous results or full arXiv mirror ships.
SAIA_EMBEDDING_PROVIDER=specter2
SAIA_EMBEDDING_MODEL=
SAIA_TORCH_NUM_THREADS=2
SAIA_EMBEDDING_BATCH=8
HORIZON_WORKER_CPUS=2.0
HORIZON_WORKER_MEMORY=6g

# Optional local alternative: set provider=ollama, model=bge-m3 after pulling
# that model on the host. Its scientific output differs from SPECTER2.
SAIA_OLLAMA_URL=http://host.docker.internal:11434

# Optional API contacts and credentials. Availability/quotas may limit live
# retrieval. Keep real values in .env only; never commit or ship that file.
SAIA_MAILTO=
OPENALEX_MAILTO=
OPENALEX_API_KEY=
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=
SEMANTIC_SCHOLAR_API_KEY=
EVENT_REGISTRY_API_KEY=
MEDIACLOUD_API_KEY=
MEDIACLOUD_COLLECTION_IDS=
LENS_API_TOKEN=
